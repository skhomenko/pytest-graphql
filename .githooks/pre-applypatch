#!/bin/sh
# pytest-graphql pre-applypatch hook. Thin dispatcher.
# Git runs this for "git am" after the patch is applied and before the commit,
# where pre-commit never runs.
# The checks live in scripts/git_hook_checks.py, which is self-tested.
set -eu
exec python3 "$(git rev-parse --show-toplevel)/scripts/git_hook_checks.py" pre-applypatch
